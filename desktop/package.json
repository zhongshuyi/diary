{
  "name": "diary-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "A focused Electron desktop shell for the Diary app",
  "main": "src/main.cjs",
  "scripts": {
    "build": "vite build",
    "dist:win": "pnpm run build && electron-builder --win nsis",
    "test": "node --test src/main/**/*.test.cjs",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build && electron ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@milkdown/core": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/plugin-clipboard": "^7.22.1",
    "@milkdown/plugin-cursor": "^7.22.1",
    "@milkdown/plugin-history": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/preset-gfm": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@milkdown/theme-nord": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "lucide-react": "^1.20.0",
    "motion": "^13.3.0",
    "quill": "^2.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "com.ling.diary.desktop",
    "productName": "Diary",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
